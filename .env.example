# Liquidity Hunter — environment template
#
# Copy to `.env` and fill in your own values. `.env` is gitignored; this
# template is the only version that belongs in the repository.
#
#   cp .env.example .env
#
# ── Telegram alerts (REQUIREMENTS §14, §26) ─────────────────────────────────
#
# Bot token, issued by @BotFather. NEVER commit this, never paste it into chat,
# never put it in a tracked file.
TELEGRAM_BOT_TOKEN=
#
# Target chat or group id that alerts are delivered to.
#
# To find it: create/choose a group, add your bot to that group, send any
# message in the group, then run the setup helper — it lists every chat the bot
# can see and can write the id here for you:
#
#   npx tsx artifacts/api-server/src/scripts/telegram-setup.ts
#
TELEGRAM_CHAT_ID=

# ── Market data (REQUIREMENTS §3, §26) ──────────────────────────────────────
#
# All market endpoints are PUBLIC. No Binance key, no account, no secret.
# Override only if you need a specific futures mirror:
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_FSTREAM_BASE=wss://fstream.binance.com

# ── Persistence (REQUIREMENTS §11) ──────────────────────────────────────────
#
# SQLite file for the liquidity ledger. Defaults to ./data/liquidity.db.
# SQLITE_PATH=./data/liquidity.db

# ── Runtime tuning (optional) ───────────────────────────────────────────────
#
# CONFIG_PATH=./config.yaml
# LOG_LEVEL=info
